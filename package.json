{
	"name": "current-view",
	"version": "1.6.4",
	"private": true,
	"description": "Automatically set the view mode (Reading, Live Preview, Source) for notes in Obsidian using folder rules, file patterns, or frontmatter.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "vitest run",
		"test:watch": "vitest",
		"coverage": "vitest run --coverage",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [],
	"author": "Lucas Ostmann",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^26.0.0",
		"@typescript-eslint/eslint-plugin": "8.71.2",
		"@typescript-eslint/parser": "8.71.2",
		"@vitest/coverage-v8": "^5.0.4",
		"builtin-modules": "5.2.0",
		"conventional-changelog-conventionalcommits": "^9.1.0",
		"esbuild": "0.28.2",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"obsidian": "latest",
		"tslib": "2.8.1",
		"typescript": "5.9.3",
		"vitest": "^5.0.4"
	},
	"dependencies": {
		"semantic-release-plugin-update-version-in-files": "^2.0.0"
	},
	"overrides": {
		"eslint-plugin-obsidianmd": {
			"moment": "^2.31.0"
		}
	}
}
